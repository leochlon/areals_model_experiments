{
  "model": {
    "width": 192,
    "heads": 4,
    "latents": 256,
    "encoder_depth": 4,
    "decoder_depth": 2,
    "ff_multiplier": 4,
    "fourier_bands": 8,
    "min_wavelength": 0.05,
    "max_wavelength": 4.0,
    "dropout": 0.0,
    "query_chunk": 256,
    "normal_head": "projector",
    "normal_prior": "surfels",
    "distance_prior": "surfels",
    "surfels_per_token": 8,
    "input_condition": "complete",
    "symmetry_prior": "maps",
    "symmetry_maps": 16
  },
  "data": {
    "encoder_points": 4096,
    "queries": 1024,
    "mask_fraction": 0.6,
    "full_input_probability": 0.1,
    "mask_patches": 32,
    "near_fraction": 0.7,
    "near_sigma": 0.03,
    "normal_band": 0.1,
    "box_padding": 0.15,
    "target_mode": "provided",
    "augment_rotation": "so3",
    "normal_sign_flip_probability": 0.5,
    "bad_records": "raise"
  },
  "train": {
    "epochs": 15,
    "batch_size": 32,
    "accumulation": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.05,
    "warmup_epochs": 0,
    "warmup_steps": 200,
    "min_lr_ratio": 0.05,
    "gradient_clip": 1.0,
    "normal_weight": 1.0,
    "normal_loss": "unoriented",
    "huber_delta": 0.05,
    "workers": 8,
    "seed": 17,
    "amp": "bf16",
    "normal_penalty": "cosine"
  }
